prefix=/tmp/ffmpeg_install
exec_prefix=${prefix}
libdir=/tmp/ffmpeg_install/lib
includedir=/tmp/ffmpeg_install/include

Name: libswresample
Description: FFmpeg audio resampling library
Version: 7.7.100
Requires: libavutil >= 61.20.100
Requires.private: 
Conflicts:
